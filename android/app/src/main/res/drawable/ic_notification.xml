<?xml version="1.0" encoding="utf-8"?>
<!--
  Durum çubuğundaki bildirim simgesi: Yolla'nın Y çatalı.

  Tek renk siluet olmak zorunda — Android bildirim simgesinin yalnızca alfa
  kanalını kullanıyor, rengi kendisi veriyor. Renkli başlatıcı ikonu buraya
  konursa çoğu telefonda beyaz bir leke olarak çıkıyor.

  Markadaki kol uçlarındaki delikler burada yok: 24dp'de birkaç piksele
  düşüp bulanıklıktan başka bir şey olmuyorlar. Çatalın kendisi zaten
  tanınıyor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Gövde ve sağ kol tek parça; markada da kesintisiz akıyor. -->
    <path
        android:pathData="M12,17.75 V12.85 Q12,11.35 13,10.25 L16.8,6.25"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Sol kol ayrı duruyor: birleşme noktasındaki çentik markanın imzası. -->
    <path
        android:pathData="M7.2,6.25 L10.9,10.65"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
