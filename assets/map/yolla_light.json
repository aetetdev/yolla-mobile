{
  "version": 8,
  "name": "Yolla Açık",
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "tiles": ["{TILE_BASE}/turkiye/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap katkıcıları"
    }
  },
  "layers": [
    {
      "id": "arka-plan",
      "type": "background",
      "paint": { "background-color": "#F7F5F2" }
    },
    {
      "id": "kara",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#F2EFEA" }
    },
    {
      "id": "yesil-alan",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", "kind", "park", "forest", "wood", "nature_reserve", "grass", "scrub", "cemetery", "farmland"],
      "paint": { "fill-color": "#E4E9DF" }
    },
    {
      "id": "yerlesim",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", "kind", "residential", "commercial", "industrial", "retail"],
      "paint": { "fill-color": "#EFEBE6" }
    },
    {
      "id": "su",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": { "fill-color": "#CFE0E2" }
    },
    {
      "id": "akarsu",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#CFE0E2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2]
      }
    },
    {
      "id": "binalar",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#E6E1DA", "fill-opacity": 0.85 }
    },
    {
      "id": "yol-kucuk",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["in", "kind", "minor_road", "path"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 16, 3]
      }
    },
    {
      "id": "yol-orta",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["==", "kind", "medium_road"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 5]
      }
    },
    {
      "id": "yol-ana",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", "kind", "major_road", "highway"],
      "paint": {
        "line-color": "#EFD9C4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 16, 7]
      }
    },
    {
      "id": "sinirlar",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "filter": ["<=", "kind_detail", 2],
      "paint": {
        "line-color": "#C9BFB6",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "yer-adlari",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": ["in", "kind", "country", "region", "locality"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:tr"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6B615B",
        "text-halo-color": "#F7F5F2",
        "text-halo-width": 1.4
      }
    }
  ]
}
